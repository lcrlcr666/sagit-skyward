# 统一换行符：repo 里存 LF，Windows 检出 CRLF 只给 PowerShell 用
* text=auto

*.sh    text eol=lf
*.mk    text eol=lf
*.rc    text eol=lf
*.te    text eol=lf
*.fstab text eol=lf
*.ini   text eol=lf
*.conf  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf
*.fragment text eol=lf
*.ps1   text eol=crlf

# 二进制
*.img   binary
*.zip   binary
*.ko    binary
*.bin   binary
