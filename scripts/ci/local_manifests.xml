<?xml version="1.0" encoding="UTF-8"?>
<!--
  local_manifests —— 补齐 minimal-manifest-twrp 里缺的项目

  已核对 minimal-manifest-twrp/twrp-9.0 的 default.xml（685 个项目）：
    * 有 prebuilts/misc，但**没有 system/tools/mkbootimg**
      → 打包 recovery.img 时 $(HOST_OUT_EXECUTABLES)/mkbootimg 不存在，
        进度会推到最后一步才报 "No rule to make target .../mkbootimg"
      → 同时 unpack_bootimg.py 也拿不到（我们抽 TWRP 内核要用）
  这个 local manifest 会在 repo sync 前由 scripts/ci/build-recovery-ci.sh 写入
  $AOSP_DIR/.repo/local_manifests/
-->
<manifest>
  <project path="system/tools/mkbootimg"
           name="platform/system/tools/mkbootimg"
           groups="pdk" />
</manifest>
