# sagit-wifi.fragment — 追加进 arch/arm64/configs/sagit_defconfig 的内核选项
# 目的：① WiFi 驱动能加载 ② recovery 下有 framebuffer / VT / loop，
#       供第二阶段 Linux 的 Xorg(fbdev) 和 chromium 使用

# ---- 无线 ----
CONFIG_WLAN=y
CONFIG_QCA_CLD_WLAN=m
CONFIG_CNSS=y
CONFIG_CNSS2=y
CONFIG_WCNSS_CORE=y
CONFIG_WLAN_FEATURE_11W=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_CFG80211_WEXT=y
CONFIG_RFKILL=y

# ---- 显示 / framebuffer（关键：没有这些 /dev/fb0 不出现）----
CONFIG_DRM=y
CONFIG_DRM_MSM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FONTS=y
CONFIG_FONT_8x16=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_UNIX98_PTYS=y

# ---- 输入 ----
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_INPUT_UINPUT=y

# ---- 让 chroot 环境跑得起来 ----
CONFIG_BLK_DEV_LOOP=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_SQUASHFS=y
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_IPC_NS=y

# ---- 网络 ----
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_NETFILTER=y
CONFIG_NF_CONNTRACK=y
CONFIG_TUN=y

# ---- 音频（云游戏出声）----
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_USB_AUDIO=y
CONFIG_SND_SOC_MSM8998=y
CONFIG_SND_SOC_WCD9335=y
