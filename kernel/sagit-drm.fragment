# sagit-drm.fragment —— 显示栈换成 DRM + 打开 WiFi 的调试通道
#
# 两件事：
# 1) 显示：默认 sagit_defconfig 只有老的 fbdev 栈（CONFIG_FB_MSM_MDSS），
#    设备上没有 /dev/dri。Skyward 的界面走 DRM/KMS，所以这里开 DRM 并关掉
#    冲突的 fbdev 栈（两套 mdss_io_util.c / sde_io_util.c 定义同名符号）。
# 2) WiFi：CONFIG_QCA_CLD_WLAN 在 sagit_defconfig 里是内建（=y），所以驱动
#    就在内核里，不需要厂商 .ko。这里打开 ICNSS_DEBUG / DYNAMIC_DEBUG /
#    DEBUG_FS，好让 WCNSS 引导失败时有地方可看：
#      mount -t debugfs debugfs /sys/kernel/debug
#      cat /sys/kernel/debug/icnss/*
#      echo 'file icnss* +p' > /sys/kernel/debug/dynamic_debug/control
#
# 不要放 CONFIG_WCNSS_CORE 之类的无线组合项 —— 那会让 wcnss_wlan.c 走进
# 该内核版本不存在的调试路径，编译直接失败（踩过）。

# ---- DRM/KMS 显示栈 ----
CONFIG_DRM=y
CONFIG_DRM_MSM=y
CONFIG_DRM_MSM_DSI=y
CONFIG_DRM_MSM_DSI_STAGING=y
CONFIG_DRM_MSM_DSI_PLL=y
CONFIG_DRM_MSM_DSI_28NM_PHY=y
CONFIG_DRM_MSM_DSI_20NM_PHY=y
CONFIG_DRM_MSM_DSI_14NM_PHY=y
CONFIG_DRM_MSM_DSI_10NM_PHY=y
CONFIG_DRM_MIPI_DSI=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_PANEL=y
CONFIG_DRM_BRIDGE=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# ---- 关掉冲突的老 fbdev MSM 栈 ----
# CONFIG_FB_MSM is not set
# CONFIG_FB_MSM_MDSS is not set
# CONFIG_FB_MSM_MDSS_WRITEBACK is not set
# CONFIG_FB_MSM_MDSS_HDMI_PANEL is not set
# CONFIG_FB_MSM_MDSS_DP_PANEL is not set

# ---- WiFi / WCNSS 的调试通道 ----
CONFIG_DEBUG_FS=y
CONFIG_DYNAMIC_DEBUG=y
CONFIG_ICNSS=y
CONFIG_ICNSS_DEBUG=y
CONFIG_CNSS_GENL=y

# ---- 输入 / VT / loop ----
CONFIG_INPUT_EVDEV=y
CONFIG_UNIX98_PTYS=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_TMPFS_XATTR=y
